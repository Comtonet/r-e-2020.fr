DirectoryIndex index.php
RewriteEngine On

# Temporary password protection for the development site.
# access.php is the only public entry point until the access cookie is present.
RewriteCond %{REQUEST_URI} !^/access\.php$ [NC]
RewriteCond %{HTTP:Cookie} !(^|;[[:space:]]*)keeplanet_site_access=kp_6f41c8e2a73d91b4f06e(;|$) [NC]
RewriteRule ^ /access.php [R=302,L]

# Preserve historic SEO URLs.
RewriteRule ^processus-de-realisation/?$ /processus-de-realisation-dune-etude-re2020/ [R=301,L]
RewriteRule ^dossiers/processus-de-realisation-dune-etude-re2020/?$ /processus-de-realisation-dune-etude-re2020/ [R=301,L]
RewriteRule ^dossiers/?$ /dossiers-decryptages-re2020/ [R=301,L]

# Serve KeePote from the exact PNG source stored in Git.
RewriteRule ^assets/img/keepote-nu-assis-simple\.png$ assets/img/keepote-nu-assis-simple.php [L]

# Preserve real files and directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Canonical HTTPS is expected to be handled by Plesk/hosting.
RewriteRule ^ index.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
